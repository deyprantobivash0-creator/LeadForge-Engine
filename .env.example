# Development template only. Never copied/read automatically.
# Set ENVIRONMENT=development in the shell and LEADFORGE_ENV_FILE=.env to opt in.
# See docs/CONFIGURATION.md. Secret fields below are intentionally empty.
APP_NAME=LeadForge Engine
VERSION=1.0.0
ENVIRONMENT=development

DATABASE_URL=sqlite:///./leadforge.db
# Disposable local PostgreSQL database from docker-compose.yml (use instead of SQLite):
# DATABASE_URL=postgresql+psycopg://leadforge_dev:leadforge_dev_only@127.0.0.1:55432/leadforge_dev

AI_PROVIDER=mock
AI_TIMEOUT_SECONDS=20
AI_MAX_ATTEMPTS=2
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_MODEL=llama3.1

GEMINI_API_KEY=
DEEPSEEK_API_KEY=

OLLAMA_HOST=http://localhost:11434

HUBSPOT_ACCESS_TOKEN=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOG_LEVEL=INFO
# Operational warning threshold in milliseconds; see docs/OBSERVABILITY.md.
SLOW_REQUEST_MS=2000

RATE_LIMIT_ENABLED=true

# Secure cookies are mandatory in production. Local HTTP requires false.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_NAME=leadforge_session
CSRF_COOKIE_NAME=leadforge_csrf
CSRF_HEADER_NAME=X-CSRF-Token
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SAMESITE=lax
